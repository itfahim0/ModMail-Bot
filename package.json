{
    "name": "modmail-monorepo",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "mcp:sync": "node scripts/sync-mcp.cjs",
        "validate-env": "node scripts/validate-env.cjs",
        "antigravity": "node scripts/antigravity.cjs",
        "prisma:generate": "turbo run prisma:generate",
        "postinstall": "pnpm mcp:sync && pnpm prisma:generate"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.6.1",
        "@commitlint/config-conventional": "^19.6.0",
        "dotenv": "^16.4.5",
        "lint-staged": "^15.5.2",
        "prettier": "^3.4.2",
        "turbo": "^2.3.3"
    },
    "packageManager": "pnpm@9.15.0"
}
